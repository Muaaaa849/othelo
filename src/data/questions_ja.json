   "depth": 2,
   "text": "一番印象に残っている旅行の思い出は？"
  },
  {
   "category": "MEMORY",
   "depth": 2,
   "text": "誰かに救われたなと思った経験は？"
  },
  {
   "category": "MEMORY",
   "depth": 2,
   "text": "親や先生に怒られて一番覚えていることは？"
  },
  {
   "category": "MEMORY",
   "depth": 2,
   "text": "初めて自分で決めた大きな決断は？"
  },
  {
   "category": "MEMORY",
   "depth": 2,
   "text": "昔の自分と今の自分で一番変わったところは？"
  },
  {
   "category": "MEMORY",
   "depth": 2,
   "text": "一番緊張した瞬間とそのときの気持ちは？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "人生で一番大事にしたいことは？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "これだけは許せないってことは？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "尊敬している人と、その理由は？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "自分の性格で好きなところと苦手なところは？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "仕事で大事にしていることは？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "幸せってどんなときに感じる？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "人に言われて考え方が変わった言葉は？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "自分の中で絶対に曲げたくないことは？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "理想の休日と理想の人生、共通点はある？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "お金で買えないもので一番大事なものは？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "友達とケンカしたとき、どうやって仲直りする？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "10年後、どんな自分になっていたい？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "自分を一言で表すとしたら何？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "嫌なことがあった日の立ち直り方は？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "人に頼るのは得意？苦手？どうして？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "最近、自分の中で変わった考え方は？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "年を取るのは楽しみ？不安？その理由は？"
  },
  {
   "category": "VALUES",
   "depth": 2,
   "text": "自分にとって「成功」ってどんな状態？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋人に求める一番大事なことは？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋愛で一番ドキッとした瞬間は？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "好きになる人に共通していることは？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋愛でこれだけは譲れないことは？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "理想の夫婦像やカップル像は？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "ケンカしたとき、どう仲直りしたい？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋人とは毎日連絡したい派？どうして？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋人にされてうれしかったことは？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋愛と友情、どっちを優先しちゃうタイプ？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "結婚についてどう考えてる？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "好きな人にどうやってアピールする？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋人の嫉妬はどこまでならうれしい？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋愛で失敗したなと思う経験は？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "長く付き合える人ってどんな人だと思う？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "一目ぼれってしたことある？そのときの話は？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋人と一緒に叶えたい夢は？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋人と過ごす理想の1日は？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋愛で自分が変わったなと思ったことは？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋人の「ここだけは直して」ってどこまで言える？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "恋愛で大事なのは話し合い？雰囲気？どうして？"
  },
  {
   "category": "LOVE",
   "depth": 2,
   "text": "好きな人の意外な一面を見たらどう思う？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手のどんなところが話しやすいと思う？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手と今日話して意外だったことは？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手の笑顔を見て思ったことは？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手とどんなことを一緒にやってみたい？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手にありがとうって言いたいことは？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手の「ここがすごい」と思うところは？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手が主人公の映画を作るならどんな話？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手に似合いそうな趣味をすすめるなら？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手のことで、もっと知りたいと思ったことは？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手と友達になれそうだと思った瞬間は？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手の話で一番印象に残ったことは？"
  },
  {
   "category": "YOU",
   "depth": 2,
   "text": "相手に向いてそうな休日の過ごし方は？"
  },
  {
   "category": "VALUES",
   "depth": 3,
   "text": "人生で一番後悔していることと、そこから学んだことは？"
  },
  {
   "category": "VALUES",
   "depth": 3,
   "text": "自分の中でまだ誰にも言っていない目標は？"
  },
  {
   "category": "VALUES",
   "depth": 3,
   "text": "本当はもっと認めてほしいと思っていることは？"
  },
  {
   "category": "LOVE",
   "depth": 3,
   "text": "今までの恋愛で一番自分を変えた経験は？"
  },
  {
   "category": "LOVE",
   "depth": 3,
   "text": "恋愛で本当は怖いと思っていることは？"
  },
  {
   "category": "LOVE",
   "depth": 3,
   "text": "好きな人にだけ見せる自分の一面は？"
  },
  {
   "category": "LOVE",
   "depth": 3,
   "text": "恋人に一番言ってほしい言葉とその理由は？"
  },
  {
   "category": "LOVE",
   "depth": 3,
   "text": "恋愛で本音を言えなかった瞬間は？"
  },
  {
   "category": "LOVE",
   "depth": 3,
   "text": "これから恋人とどんな関係を築いていきたい？"
  },
  {
   "category": "YOU",
   "depth": 3,
   "text": "相手に今日一番伝えたいことは？"
  },
  {
   "category": "YOU",
   "depth": 3,
   "text": "相手の本当はすごいと思っているところは？"
  },
  {
   "category": "YOU",
   "depth": 3,
   "text": "相手と出会えてよかったと思う理由は？"
  },
  {
   "category": "YOU",
   "depth": 3,
   "text": "相手に言えていなかった本音を1つ教えて？"
  },
  {
   "category": "YOU",
   "depth": 3,
   "text": "相手にこれからも変わらないでほしいところは？"
  },
  {
   "category": "YOU",
   "depth": 3,
   "text": "相手のために自分ができることは何だと思う？"
  }
 ]
}